# Copy to .env and replace the values. Keep .env out of source control.
# Virtual keys in keys.json may use a direct "key" instead; key_env entries
# such as PROXY_KEY_CI are resolved from here.
PROXY_KEY_LAPTOP=replace-with-a-long-random-value
PROXY_KEY_CI=replace-with-a-long-random-value
PROXY_KEY_ADMIN=replace-with-a-long-random-value
OPENROUTER_API_KEY=sk-or-v1-replace-me
PHALA_API_KEY=replace-with-your-phala-api-key

# Required only when server.admin_listen is set. Enables POST /admin/reload.
MODEL_PROXY_ADMIN_TOKEN=replace-with-a-long-random-value
